{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Next 16 and vitest resolve two different major `vite` versions (8.x vs. vitest's bundled
    // 7.x), so `defineConfig`'s plugin types structurally disagree here — a devDependency
    // version-skew type conflict, not a real bug (vitest itself runs this file fine at
    // build time via esbuild, untyped). Excluded from the app's own typecheck for that reason.
    "vitest.config.ts"
  ]
}
